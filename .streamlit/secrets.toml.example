# =============================================================================
# TEMPLATE — safe to commit (NO real key here).
# Local run:  copy this to  .streamlit/secrets.toml  and fill in the values.
# secrets.toml is gitignored and must NEVER be committed.
# On Streamlit Cloud: paste the [gcp_service_account] block under
#   Manage app -> ⋮ -> Settings -> Secrets  (the repo does not need it).
# =============================================================================

# Google service account with viewer access to the dashboard's Google Sheet.
# JSON key: Google Cloud Console -> IAM & Admin -> Service Accounts -> Keys ->
# Add key -> JSON. Copy each field below. Also SHARE the Sheet with client_email.
[gcp_service_account]
type                        = "service_account"
project_id                  = "your-gcp-project-id"
private_key_id              = "your-private-key-id"
# One line, quoted, with literal \n between lines (exactly as in the JSON):
private_key                 = "-----BEGIN PRIVATE KEY-----\nMIIEvQ...REST...==\n-----END PRIVATE KEY-----\n"
client_email                = "your-service-account@your-gcp-project-id.iam.gserviceaccount.com"
client_id                   = "000000000000000000000"
auth_uri                    = "https://accounts.google.com/o/oauth2/auth"
token_uri                   = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url        = "https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40your-gcp-project-id.iam.gserviceaccount.com"
universe_domain             = "googleapis.com"
